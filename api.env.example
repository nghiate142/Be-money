# Copy thành api.env rồi điền. KHÔNG commit api.env.
# File này chỉ dùng cho Docker Compose; chạy trực tiếp bằng npm thì dùng .env.

# Bỏ trống: frontend đi qua nginx cùng origin nên không cần CORS.
# Chỉ điền khi frontend chạy ở domain khác backend.
WEB_ORIGIN=

APP_USER=admin

# Sinh bằng: docker compose run --rm api node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" "mật khẩu của bạn"
APP_PASSWORD_HASH=

# Sinh bằng: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d


# Đọc ảnh hoá đơn / biến động số dư. Bỏ trống = tắt tính năng quét ảnh.
# Lấy key miễn phí ở https://aistudio.google.com/apikey (chỉ cần tài khoản Google).
GEMINI_API_KEY=
# Bỏ trống = gemini-2.5-flash (nằm trong hạn mức miễn phí).
GEMINI_MODEL=
