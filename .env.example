# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.

DATABASE_URL="file:./dev.db"

PORT=3000

# Bỏ trống = chấp nhận mọi cổng localhost.
# Khi chạy trên server, điền đúng origin của frontend, vd https://money.example.com
WEB_ORIGIN=""

# Tài khoản duy nhất của app.
# Tạo hash: npm run set-password -- "mật khẩu của bạn"  (script ghi thẳng vào .env)
APP_USER="admin"
APP_PASSWORD_HASH=""

# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài, vd: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="30d"
